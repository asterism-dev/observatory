#!/bin/sh
# Starts, stops and idle-stops the ubuntu user's xpra desktop on :100; attach with xpra attach ssh://ubuntu@<vm>.internal/100.
set -u
uid=${VMM_UID:-$(id -u)}
if [ "$uid" = 0 ]; then
	echo "vmm-desktop: run as the ubuntu user, not root" >&2
	exit 1
fi
XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$uid}
export XDG_RUNTIME_DIR
systemctl=${VMM_SYSTEMCTL_BIN:-systemctl}
xpra=${VMM_XPRA_BIN:-/usr/bin/xpra}
stamp=$XDG_RUNTIME_DIR/vmm-desktop.idle-since

case ${1:-} in
start)
	# A stamp left by an earlier session would stop the new one at its first idle check.
	rm -f "$stamp"
	"$systemctl" --user start vmm-desktop.service vmm-desktop-idle.timer || exit 1
	end=$(($(date +%s) + 5))
	until "$xpra" info :100 >/dev/null 2>&1; do
		if [ "$(date +%s)" -ge "$end" ]; then
			echo "vmm-desktop: the desktop did not answer within 5 s; see journalctl --user -u vmm-desktop" >&2
			exit 1
		fi
		sleep 0.2
	done
	;;
stop)
	rm -f "$stamp"
	exec "$systemctl" --user stop vmm-desktop.service vmm-desktop-idle.timer
	;;
status)
	exec "$systemctl" --user is-active vmm-desktop.service
	;;
idle-check)
	info=$("$xpra" info :100 2>/dev/null) || exit 0
	if printf '%s\n' "$info" | grep -qxF 'clients=0' && printf '%s\n' "$info" | grep -qxF 'state.windows=0'; then
		if [ ! -e "$stamp" ]; then
			: >"$stamp"
		elif [ -n "$(find "$stamp" -mmin +"${VMM_DESKTOP_IDLE_MINUTES:-30}")" ]; then
			rm -f "$stamp"
			exec "$systemctl" --user stop vmm-desktop.service vmm-desktop-idle.timer
		fi
	else
		rm -f "$stamp"
	fi
	;;
*)
	echo "usage: vmm-desktop start|stop|status" >&2
	exit 2
	;;
esac
