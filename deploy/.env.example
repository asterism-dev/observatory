# Copy to deploy/.env and fill in. Secrets have no defaults: the hub refuses to start without them.

# Address users open in the browser; with the tls profile https://<OBSERVATORY_DOMAIN>.
OBSERVATORY_PUBLIC_URL=
# Address nodes and devices use to reach the gateway (UDP 51820/51821); defaults to the host of OBSERVATORY_PUBLIC_URL.
OBSERVATORY_GATEWAY_HOST=
# Resolvers for devices' and VMs' non-internal names, comma-separated (default: the host's upstream resolvers; docs/network.md).
# OBSERVATORY_GATEWAY_DNS=

# OIDC provider: issuer and the two client IDs (sh deploy/idp/bootstrap.sh --print <public URL> prints all three).
OBSERVATORY_OIDC_ISSUER=
OBSERVATORY_OIDC_WEB_CLIENT_ID=
OBSERVATORY_OIDC_CLI_CLIENT_ID=

# Master key for encrypted values: openssl rand -base64 32 (keep a backup, losing it loses every secret).
OBSERVATORY_SECRETS_KEY=
# Tokens the gateway and the storage server use against the hub: openssl rand -hex 32 each.
OBSERVATORY_GATEWAY_TOKEN=
OBSERVATORY_STORAGE_TOKEN=

# Optional: id of a node installed on this host (ovs-vsctl get open . external_ids:system-id). The gateway then uses
# that node's OVS; needs -f deploy/compose.shared.yaml. See docs/network.md, "Hub and node on one host".
# OBSERVATORY_GATEWAY_NODE=

# Secret the registry sends with push notifications to the hub: openssl rand -hex 32.
OBSERVATORY_REGISTRY_EVENTS_SECRET=
# Database password: openssl rand -hex 24. Applies only when the database is first created.
POSTGRES_PASSWORD=

# Optional telemetry store settings (defaults shown): retention and the series limits that cap metric cardinality.
# OBSERVATORY_METRICS_RETENTION=30d
# OBSERVATORY_LOGS_RETENTION=14d
# OBSERVATORY_METRICS_MAX_HOURLY_SERIES=500000
# OBSERVATORY_METRICS_MAX_DAILY_SERIES=2000000

# Host port for plain HTTP. With the tls profile set 127.0.0.1:8090: Docker's published ports bypass host firewalls
# such as ufw, so 8090 would otherwise stay reachable unencrypted next to Caddy.
OBSERVATORY_HTTP_PORT=8090

# tls profile only: domain Caddy serves, and acme (public certificate) or internal (Caddy's own CA).
OBSERVATORY_DOMAIN=
OBSERVATORY_TLS=acme

# Release to run (a tag such as v0.1.0); `up --build` builds from this checkout instead.
OBSERVATORY_VERSION=latest

# Optional: docs link in the header.
# OBSERVATORY_DOCS_URL=https://asterism-dev.github.io/observatory/
